{
  "name": "video-montage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Локальный видеоредактор: кадры видео на таймлайне, расстановка mp3-озвучки, кроп, вырезка, синхронное превью и сборка в mp4 через ffmpeg.",
  "license": "GPL-3.0-or-later",
  "author": "Vladimir Miroshnichenko <vov.mir28@gmail.com>",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
